# Hito 11 - Configuracion de ejemplo
# Copiar a config/hito11_api.env y adaptar al entorno local.
# No subir credenciales ni tokens reales a Git.

# MongoDB
MONGO_URI=mongodb://fixture2030-mongodb:27017
MONGO_DATABASE=fixture2030

# Neo4j
NEO4J_URI=bolt://fixture2030-neo4j:7687
NEO4J_USER=CAMBIAR_USUARIO
NEO4J_PASSWORD=CAMBIAR_PASSWORD

# Cassandra
CASSANDRA_HOST=baseDeDatosIICassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=CAMBIAR_KEYSPACE
CASSANDRA_DATACENTER=CAMBIAR_DATACENTER

# Redis
REDIS_URL=redis://baseDeDatosIIRedis:6379/0

# InfluxDB 3
INFLUX_URL=http://fixture2030-influxdb3:8181
INFLUX_DATABASE=fixture2030
INFLUX_MODE=influx3
INFLUX_TOKEN=CAMBIAR_TOKEN

# IRIS
IRIS_HOST=baseDeDatosIIIRIS
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=CAMBIAR_USUARIO
IRIS_PASSWORD=CAMBIAR_PASSWORD
